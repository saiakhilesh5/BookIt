{
  "name": "bookit-server",
  "version": "1.0.0",
  "description": "BookIt API — scalable event & resource booking platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "seed": "node src/seed.js",
